# YR-Elearning Backend Configuration
PORT=5000

# MongoDB Connection String (User can replace with Atlas or local URI)
# Database name 'yr_elearning' is configured automatically
MONGO_URI=mongodb://127.0.0.1:27017/yr_elearning
DB_NAME=yr_elearning

# JWT Secret for Admin Authentication
JWT_SECRET=yr_elearning_secret_jwt_key_2026_xyz

# Default Admin Credentials for /login
ADMIN_EMAIL=admin@yrelearning.com
ADMIN_PASSWORD=admin123
